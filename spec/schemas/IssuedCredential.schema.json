{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssuedCredential",
  "description": "Response to credential issuance. The bearer token is returned exactly once. An idempotent replay omits token and sets token_unavailable=true (the secret is not stored); revoke and reissue if the original response was lost.",
  "type": "object",
  "required": [
    "credential"
  ],
  "properties": {
    "credential": {
      "$ref": "Credential.schema.json"
    },
    "token": {
      "type": "string",
      "pattern": "^yak\\.[^.]+\\..+$",
      "description": "Bearer token: yak.<credential_id>.<secret>."
    },
    "token_unavailable": {
      "const": true
    }
  },
  "oneOf": [
    {
      "required": [
        "token"
      ],
      "not": {
        "required": [
          "token_unavailable"
        ]
      }
    },
    {
      "required": [
        "token_unavailable"
      ],
      "not": {
        "required": [
          "token"
        ]
      }
    }
  ]
}
