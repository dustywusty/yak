{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialList",
  "description": "Credentials in (created_at, id) order.",
  "type": "object",
  "required": [
    "credentials",
    "next_page_token"
  ],
  "properties": {
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "Credential.schema.json"
      }
    },
    "next_page_token": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Opaque page token (\"k1.\" prefix); null on the last page."
    }
  }
}
