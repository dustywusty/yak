{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapshotInfo",
  "type": "object",
  "required": [
    "id",
    "board_id",
    "item_count",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque server-assigned identifier. Clients must not parse it."
    },
    "board_id": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "expires_at": {
      "$ref": "Timestamp.schema.json"
    }
  }
}
