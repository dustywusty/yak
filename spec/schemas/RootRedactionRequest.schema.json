{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RootRedactionRequest",
  "description": "Body of POST /tasks/{task_id}/root-redaction (L18, BRIEF-020).",
  "type": "object",
  "required": [
    "reason"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Non-blank; recorded with the deletion (and audited for a board_admin redaction)."
    }
  },
  "additionalProperties": false
}
