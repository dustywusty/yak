{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompleteTaskRequest",
  "description": "Body of POST /tasks/{task_id}/complete (L7). Recorded as given (CLAIM-031, CLAIM-032).",
  "type": "object",
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "description": "At most limits.max_evidence_items (413)."
        },
        "data": {
          "type": "object",
          "description": "JSON object of at most limits.max_task_result_bytes (413)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "message",
            "commit",
            "url",
            "artifact",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
