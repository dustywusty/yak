{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InboxItem",
  "type": "object",
  "required": [
    "id",
    "board_id",
    "actor_id",
    "source_kind",
    "source_id",
    "message_id",
    "thread_id",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "board_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "mention",
        "ask",
        "schedule",
        "command"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    }
  }
}
