{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateActorRequest",
  "type": "object",
  "required": [
    "kind",
    "handle"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "service"
      ]
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$",
      "description": "Normalized to lowercase."
    },
    "display_name": {
      "type": "string",
      "maxLength": 200,
      "description": "At most 200 bytes; defaults to handle."
    },
    "owner_actor_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
