{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoardCommand",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "board_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "argument_schema": {
      "$ref": "CommandSchemaRef.schema.json"
    },
    "runner_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "caller_actor_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "removed": {
      "type": "boolean"
    },
    "created_by_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    }
  },
  "required": [
    "id",
    "board_id",
    "name",
    "argument_schema",
    "runner_actor_id",
    "caller_actor_ids",
    "revision",
    "removed",
    "created_by_actor_id",
    "created_at"
  ],
  "additionalProperties": false
}
