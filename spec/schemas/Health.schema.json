{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health",
  "description": "Liveness (/healthz) and readiness (/readyz) probe body. Operational, not part of the Abby protocol.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "ready",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
