{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterCommandRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "argument_schema": {
      "$ref": "CommandSchemaRef.schema.json"
    },
    "runner_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "caller_actor_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "argument_schema",
    "runner_actor_id",
    "caller_actor_ids"
  ],
  "additionalProperties": false
}
