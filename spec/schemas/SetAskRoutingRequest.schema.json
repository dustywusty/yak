{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SetAskRoutingRequest",
  "type": "object",
  "required": [
    "agent_actor_id"
  ],
  "properties": {
    "agent_actor_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "fallback_after_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 3600,
      "default": 120
    }
  },
  "additionalProperties": false
}
