{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchBoardRequest",
  "type": "object",
  "description": "Absent members are unchanged. An empty object only bumps the revision.",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "description": "1..200 bytes of UTF-8, not blank."
    }
  },
  "additionalProperties": false
}
