{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential",
  "description": "Credential metadata. Never contains the secret or its verifier.",
  "type": "object",
  "required": [
    "id",
    "actor_id",
    "label",
    "scopes",
    "board_ids",
    "created_at",
    "expires_at",
    "revoked_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque server-assigned identifier. Clients must not parse it."
    },
    "actor_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "Free-form label; empty string when not supplied."
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "Scope.schema.json"
      },
      "minItems": 1
    },
    "board_ids": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "null: no board restriction. An array (possibly empty) restricts the credential to those boards."
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "expires_at": {
      "$ref": "Timestamp.schema.json"
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "Timestamp.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
