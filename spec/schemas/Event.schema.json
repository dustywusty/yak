        },
        "resource": {
          "properties": {
            "type": {
              "const": "ask"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "ask_id",
            "state",
            "target_actor_id",
            "recipient_actor_id"
          ],
          "properties": {
