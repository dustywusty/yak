  "$defs": {
    "ChannelCreatedPayload": {
      "type": "object",
      "required": [
        "channel"
      ],
      "properties": {
        "channel": {
          "$ref": "Channel.schema.json"
        }
      }
    },
    "ThreadCreatedPayload": {
      "description": "message is the root; replaced by its tombstone if the root is later deleted.",
      "type": "object",
      "required": [
        "thread",
        "message"
      ],
      "properties": {
        "thread": {
          "$ref": "Thread.schema.json"
        },
        "message": {
          "$ref": "Message.schema.json"
        }
      }
    },
    "MessagePayload": {
      "description": "The message after the change, with its thread context (EVT-013). Deleting a message replaces message in every earlier event about it with the tombstone; thread_title and task_id stay.",
      "type": "object",
      "required": [
        "message",
        "thread_title"
      ],
      "properties": {
        "message": {
          "$ref": "Message.schema.json"
        },
        "thread_title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the message's thread when the event was committed (EVT-013). Thread metadata, not message content: deletion and redaction leave it. Later title changes arrive as thread.updated (P2: task.updated) and do not rewrite it."
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "P2 (yak.p2.tasks): the thread's task when the event was committed, or null (TASK-086). Earlier events of a thread converted later keep null; task.created carries the link."
        }
      }
    },
    "MessageDeletedPayload": {
      "type": "object",
      "required": [
        "message",
        "thread_title"
      ],
      "properties": {
        "message": {
          "allOf": [
            {
              "$ref": "Message.schema.json"
            },
            {
              "type": "object",
              "required": [
                "deleted",
                "text"
              ],
              "properties": {
                "deleted": {
                  "type": "object"
                },
                "text": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "thread_title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the message's thread when the event was committed (EVT-013). Thread metadata, not message content: deletion and redaction leave it. Later title changes arrive as thread.updated (P2: task.updated) and do not rewrite it."
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "P2 (yak.p2.tasks): the thread's task when the event was committed, or null (TASK-086). Earlier events of a thread converted later keep null; task.created carries the link."
        }
      }
    },
    "MessageLabelsChangedPayload": {
      "type": "object",
      "required": [
        "message",
        "thread_title",
        "labels_before",
        "labels_after"
      ],
      "properties": {
        "message": {
          "$ref": "Message.schema.json"
        },
        "thread_title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the message's thread when the event was committed (EVT-013). Thread metadata, not message content: deletion and redaction leave it. Later title changes arrive as thread.updated (P2: task.updated) and do not rewrite it."
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "P2 (yak.p2.tasks): the thread's task when the event was committed, or null (TASK-086). Earlier events of a thread converted later keep null; task.created carries the link."
        },
        "labels_before": {
          "$ref": "Labels.schema.json"
        },
        "labels_after": {
          "$ref": "Labels.schema.json"
        }
      }
    },
    "ThreadViewInvalidatedPayload": {
      "description": "Root labels changed: consumers refresh or drop the thread's cached messages. P2: reason task_state_changed when the effective task state (yak.task.state) changed (TASK-085).",
      "type": "object",
      "required": [
        "thread",
        "reason",
        "labels_before",
        "labels_after"
      ],
      "properties": {
        "thread": {
          "$ref": "Thread.schema.json"
        },
        "reason": {
          "type": "string",
          "enum": [
            "root_labels_changed",
            "task_state_changed"
          ]
        },
        "labels_before": {
          "$ref": "Labels.schema.json"
        },
        "labels_after": {
          "$ref": "Labels.schema.json"
        }
      }
    },
    "ThreadUpdatedPayload": {
      "type": "object",
      "required": [
        "thread"
      ],
      "properties": {
        "thread": {
          "$ref": "Thread.schema.json"
        }
      }
    },
    "TaskCreatedPayload": {
      "description": "L1, L2.",
      "type": "object",
      "required": [
        "task",
        "origin",
        "batch_id"
      ],
      "properties": {
        "task": {
          "$ref": "Task.schema.json"
        },
        "origin": {
          "type": "string",
          "enum": [
            "new_thread",
            "converted",
            "batch",
            "command"
          ],
          "description": "The command value is a proposed P3 extension, gated by yak.commands (CMD-008)."
        },
        "batch_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskClaimPayload": {
      "description": "task.claimed (L3) and task.claim_renewed (L4). Never carries a proof.",
      "type": "object",
      "required": [
        "task",
        "claim"
      ],
      "properties": {
        "task": {
          "$ref": "Task.schema.json"
        },
        "claim": {
          "$ref": "Claim.schema.json"
        }
      }
    },
    "TaskReleasedPayload": {
      "description": "L5.",
      "type": "object",
      "required": [
        "task",
        "claim",
        "reason"
      ],
      "properties": {
        "task": {
          "$ref": "Task.schema.json"
        },
        "claim": {
          "$ref": "Claim.schema.json"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TaskClaimExpiredPayload": {
      "description": "L6. effective_at = claim.expires_at; recorded_at = materialization time (CLAIM-052).",
      "type": "object",
      "required": [
