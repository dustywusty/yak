{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One committed change in a board's event stream. payload shape is selected by type. Consumers deduplicate by id.",
  "type": "object",
  "required": [
    "id",
    "cursor",
    "type",
    "board_id",
    "actor_id",
    "credential_id",
    "run_id",
    "resource",
    "channel_id",
    "thread_id",
    "recorded_at",
    "effective_at",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque server-assigned identifier. Clients must not parse it."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque read position (\"c1.\" prefix) bound to board, query, history epoch and effective policy."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+$"
    },
    "board_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource": {
      "type": "object",
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "channel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "$ref": "Timestamp.schema.json"
    },
    "effective_at": {
      "$ref": "Timestamp.schema.json",
      "description": "When the change took effect. Equals recorded_at except task.claim_expired, where it is the claim's expires_at; consumers must not assume it is monotonic in stream order (CLAIM-054)."
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "channel.created"
        },
        "resource": {
          "properties": {
            "type": {
              "const": "channel"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/ChannelCreatedPayload"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "thread.created"
        },
        "resource": {
          "properties": {
            "type": {
              "const": "thread"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/ThreadCreatedPayload"
        }
      }
    },
    {
