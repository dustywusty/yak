    {
      "description": "Forward compatibility: event types not defined by this version. Clients ignore types they do not understand.",
      "properties": {
        "type": {
          "not": {
            "enum": [
              "channel.created",
              "thread.created",
              "message.created",
              "message.edited",
              "message.deleted",
              "message.labels_changed",
              "thread.view_invalidated",
              "thread.updated",
              "task.created",
              "task.claimed",
              "task.claim_renewed",
              "task.released",
              "task.claim_expired",
              "task.completed",
              "task.failed",
              "task.blocked",
              "task.unblocked",
              "task.canceled",
              "task.reopened",
              "task.became_ready",
              "task.dependencies_changed",
              "task.assigned",
              "task.updated",
              "task.brief_updated",
              "task.brief_redacted",
              "actor.presence_changed",
              "ask.created",
              "ask.answered",
              "ask.routed",
              "ask.expired",
              "ask.withdrawn"
            ]
          }
        }
      }
    },
    {
