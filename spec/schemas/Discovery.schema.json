{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery",
  "description": "GET /v1/server: protocol versions, capabilities, limits and retention. Unauthenticated.",
  "type": "object",
  "required": [
    "protocol",
    "implementation",
    "capabilities",
    "limits",
    "retention",
    "authentication"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": [
        "name",
        "versions",
        "status",
        "profiles"
      ],
      "properties": {
        "name": {
          "const": "abby"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "description": "Specification maturity, e.g. draft."
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Conformance profiles, e.g. abby.p1.core."
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.]+$"
      },
      "uniqueItems": true,
      "description": "Advertised capability identifiers."
    },
    "limits": {
      "type": "object",
      "required": [
        "max_request_bytes",
        "max_text_bytes",
        "max_title_bytes",
        "max_labels_per_message",
        "max_label_key_bytes",
        "max_label_value_bytes",
        "max_channel_path_bytes",
        "max_page_size",
        "max_wait_ms",
        "snapshot_max_items",
        "credential_max_ttl_seconds"
      ],
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_text_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_title_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_labels_per_message": {
          "type": "integer",
          "minimum": 0
        },
        "max_label_key_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_label_value_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_channel_path_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_page_size": {
          "type": "integer",
          "minimum": 0
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_max_items": {
          "type": "integer",
          "minimum": 0
        },
        "credential_max_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "idempotency_seconds",
        "events_seconds",
        "snapshot_seconds"
      ],
      "properties": {
        "idempotency_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "events_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authentication": {
      "type": "object",
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bearer"
            ]
          },
          "minItems": 1
        }
      }
    }
  }
}
