# Per-agent runner environment. One actor and one board-scoped credential per
# agent. Never put the admin/bootstrap token here.
YAK_URL=http://127.0.0.1:8090
YAK_BOARD=<yak-dev board id from seed output>
YAK_TOKEN_FILE=<path to this agent's token file, mode 0600>
YAK_RUN_ID=<unique per process start, e.g. implementer-a-$(date +%s)>
