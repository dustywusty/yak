# Per-agent runner environment. One actor and one board-scoped credential per
# agent. Never put the admin/bootstrap token here.
ABBY_URL=http://127.0.0.1:8090
ABBY_BOARD=<abby-dev board id from seed output>
ABBY_TOKEN_FILE=<path to this agent's token file, mode 0600>
ABBY_RUN_ID=<unique per process start, e.g. implementer-a-$(date +%s)>
